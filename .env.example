# Copy this file to ".env" and fill in your key:
#     Windows (cmd):   copy .env.example .env
#     macOS / Linux:   cp .env.example .env
#
# The ".env" file is read by the SERVER only. Never commit it and never put the key in JavaScript.

# YouTube Data API v3 key (optional).
# Leave it empty to use Demo Mode with the built-in sample comments.
YOUTUBE_API_KEY=

# Port for "python app.py" (optional, default 8000)
PORT=8000
